# ─── Database ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (Transaction mode)
DATABASE_URL=

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Your production URL (no trailing slash)
BETTER_AUTH_URL=https://yourdomain.com

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# GitHub: github.com/settings/developers → OAuth Apps
# Callback URL: https://yourdomain.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: console.cloud.google.com → APIs & Services → Credentials
# Callback URL: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Piston (code execution sandbox) ─────────────────────────────────────────
# Your self-hosted Piston instance (Railway, Fly.io, etc.)
PISTON_URL=https://your-piston.railway.app/api/v2/execute

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# upstash.com → Redis → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Supabase (public — safe to expose) ──────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── App URL (public) ────────────────────────────────────────────────────────
# Same as BETTER_AUTH_URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── PostHog Analytics (public) ──────────────────────────────────────────────
# posthog.com → Project Settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# Default: https://us.i.posthog.com (or https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
